# Copy to .env. Replace every CHANGE_ME value with an independent local secret.
CORE_DB_PASSWORD=CHANGE_ME_core_db
TURF_DB_PASSWORD=CHANGE_ME_turf_db
JWT_SECRET=CHANGE_ME_at_least_32_random_characters_for_user_JWTs
INTERNAL_SERVICE_KEY=CHANGE_ME_at_least_32_random_characters_for_service_calls
MINIO_ROOT_USER=tecgensoft-local
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password
BRANCH_ADMIN_EMAIL_DOMAIN=legacy.local
BRANCH_ADMIN_COMMON_PASSWORD=CHANGE_ME_legacy_activation_password
SUPER_ADMIN_BOOTSTRAP_ENABLED=true
SUPER_ADMIN_FIRST_NAME=Local
SUPER_ADMIN_LAST_NAME=Administrator
SUPER_ADMIN_EMAIL=admin@example.test
SUPER_ADMIN_PASSWORD=CHANGE_ME_local_super_admin_password
CORS_ALLOWED_ORIGINS=http://localhost:3000
