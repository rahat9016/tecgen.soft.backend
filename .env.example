# Copy to .env. Replace every CHANGE_ME value with an independent local secret.
CORE_DB_PASSWORD=CHANGE_ME_core_db
TURF_DB_PASSWORD=CHANGE_ME_turf_db
JWT_SECRET=320760df18d1b17a92939e4cb9623a3f9356f966077ff1b1df4b364e6a1ad55e
INTERNAL_SERVICE_KEY=CHANGE_ME_at_least_32_random_characters_for_service_calls
MINIO_ROOT_USER=tecgensoft-local
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password
ORGANIZATION_ADMIN_EMAIL_DOMAIN=legacy.local
ORGANIZATION_ADMIN_COMMON_PASSWORD=CHANGE_ME_legacy_activation_password
SUPER_ADMIN_BOOTSTRAP_ENABLED=true
SUPER_ADMIN_FIRST_NAME=Local
SUPER_ADMIN_LAST_NAME=Administrator
SUPER_ADMIN_EMAIL=admin@gmail.com
SUPER_ADMIN_PASSWORD=CHANGE_ME_local_super_admin_password
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
FLYWAY_ENABLED=true
SPRING_PROFILES_ACTIVE=local
TURF_API_URL=http://localhost:8081
TURF_PAYMENT_WINDOW_MINUTES=60
# Gateway. Organization sites are read from Core; list only Tecgen Soft's own panels here.
PLATFORM_ORIGINS=https://admin.tecgensoft.com,http://localhost:3000
# Local development only: accept http and custom ports for organization origins.
ALLOW_INSECURE_ORIGINS=false
# Comma-separated addresses or CIDR ranges of the reverse proxy in front of the gateway.
TRUSTED_PROXIES=
# Comma-separated addresses of frontend servers that render pages (higher rate limits).
SSR_CLIENT_IPS=
